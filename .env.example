# ==============================================================================
# SHARYAR TRADING SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and populate with your personal API credentials.
# Do NOT commit actual secrets or live keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PAKISTAN STOCK EXCHANGE (PSX) CONFIGURATION
# ------------------------------------------------------------------------------
# Official or public PSX market data endpoint (default: https://dps.psx.com.pk)
PSX_API_URL=https://dps.psx.com.pk

# Public or private API key for PSX data services (Leave empty for free open endpoints)
PSX_API_KEY=

# Preferred data source adapter: "auto", "dps", "direct_rest", or "custom"
PSX_DATA_SOURCE=auto

# Cooldown buffer (in seconds) between outbound requests to prevent rate-limit throttling
PSX_RATE_LIMIT_SEC=0.10

# In-memory TTL cache duration (in seconds) for real-time quotes and benchmarks
PSX_CACHE_TTL_SEC=15.0

# ------------------------------------------------------------------------------
# 2. BINANCE CRYPTO EXCHANGE API CONFIGURATION
# ------------------------------------------------------------------------------
# Binance Spot & Futures REST/WebSocket API credentials
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ------------------------------------------------------------------------------
# 3. TERMINAL ACCESS GATEWAY
# ------------------------------------------------------------------------------
# Master secret access key to unlock the professional trading terminal
# Default fallback: SHARYAR or شریار
SHARYAR_TERMINAL_SECRET_KEY=SHARYAR

# ------------------------------------------------------------------------------
# 4. SYSTEM RUNTIME SETTINGS
# ------------------------------------------------------------------------------
STREAMLIT_PORT=8501
STREAMLIT_HOST=localhost
